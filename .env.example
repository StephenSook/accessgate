# AccessGate — environment variable template
# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit real keys.

# --------------------------------------------------------------------------
# IBM watsonx.ai Lite (optional — enables the hosted showcase inference call)
# Get these from cloud.ibm.com after creating a watsonx.ai Lite project.
# --------------------------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --------------------------------------------------------------------------
# AccessGate API server
# --------------------------------------------------------------------------
# Host and port are passed to uvicorn on the command line, not read from the
# environment. ACCESSGATE_HOST / ACCESSGATE_PORT were documented here and read
# by nothing; rather than leave a setting that silently does nothing, use:
#   uvicorn src.app:app --host 0.0.0.0 --port 8000

# --------------------------------------------------------------------------
# Ollama (optional overrides — defaults work if Ollama runs on localhost)
# --------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# Configured in code via logging.basicConfig, not from the environment. A
# LOG_LEVEL variable was documented here and read by nothing.
