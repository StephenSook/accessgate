# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Secrets
.env
*.env

# Model weights / large binary data
*.gguf
*.bin
*.pt
*.pth
data/training/*.pkl
standards/index/*.faiss
standards/index/*.pkl

# Node
node_modules/
frontend/dist/
