# OS
.DS_Store

# Bob sessions. Raw transcripts stay out on purpose: they are large, and they
# carry verbatim planning prompts rather than engineering artifacts. The
# aggregate written by scripts/export_bob_evidence.py is counts only, and is the
# judge-facing Bob evidence, so it is excepted below.
bob_sessions/*.json
!bob_sessions/bob-usage-evidence.json
# Same reasoning: counts and repository-relative paths only, written by
# scripts/recover_bob_attribution.py, no contribution text and no absolute paths.
!bob_sessions/bob-attribution-recovered.json

# Gitkeep exceptions
!security/.gitkeep
!bob_sessions/.gitkeep
!standards/parsed/.gitkeep
!standards/index/.gitkeep

# Trained model weights
data/training/classifier.pkl

# Internal research / strategy documents (stay local, never public)
*.pdf
AccessGate_Master_Build_Spec.md
PLAN_MODE_PROMPTS.md

# Stray root files that belong in .bob/ only
/SKILL.md
/custom_modes.yaml

# Frontend design brief (internal notes)
frontend visual

# Bob-kit reference (local only)
.bob/bob-kit-AGENTS.md

# Large source media (demo film) — not committed; used to generate demo_report.json
data/demo/source/

# Playwright + local verification artifacts
.playwright-mcp/
accessgate-*.png
accessgate-*.jpeg

# SkillsBuild certificate — personal (name); upload to BeMyApp form, not the public repo
submission/*.pdf

# Internal build/strategy plan — scaffolding, not product docs (kept local only)
plan/
submission/*.md
